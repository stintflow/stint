<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.stintflow</groupId>
        <artifactId>stint-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>stint-aws</artifactId>
    <name>Stint :: Connectors :: AWS</name>
    <description>AWS connectors: S3 (blob), DynamoDB (state), SQS/SNS/EventBridge (transport), SQS-delay (timer). Quarkus + native friendly; floci-testable.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.stintflow</groupId>
            <artifactId>stint-wire</artifactId>
        </dependency>

        <!-- CDI + config -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!-- Quarkus AWS extensions (native-friendly). Versions managed by the platform BOM. -->
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-dynamodb</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-sns</artifactId>
        </dependency>

        <!-- SDD 3b.5b: the key of an area, on KMS (plain SDK client: the adapter is built by the caller, as in the tests) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kms</artifactId>
        </dependency>

        <!-- Sync HTTP client used by the Quarkus AWS extensions -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- SDD 2.7: EventBridge (SDD 2.2) and EventBridge Scheduler (SDD 2.4) through their Quarkiverse extensions,
             like S3/DynamoDB/SQS/SNS above: the extensions produce the clients and register what the native image
             needs. (SDD 2.2/2.4 assumed no extension existed; the 3.33.2 platform BOM has both.) -->
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-eventbridge</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-scheduler</artifactId>
        </dependency>
        <!-- tests (SDD 2.4) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Embeds a Jandex index in the jar so every @ApplicationScoped class here (S3BlobStore,
                 DynamoDbStateStore, Sqs/Sns/EventBridgeTaskTransport, SqsDelayTimerService) is
                 discoverable as a CDI bean by ANY Quarkus consumer of this jar, with no
                 quarkus.index-dependency workaround needed on their side. Found while validating
                 stint-aws as an external library dependency (not part of any SDD's registered scope;
                 approved directly in chat). -->
            <plugin>
                <groupId>org.jboss.jandex</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>1.2.3</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SDD 1.5, CA1: fails fast at mvn validate, before any compile/test — complements the
                 consolidated ArchUnit suite with a build-time-earliest check of the same boundary. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>no-stint-core</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.github.stintflow:stint-core:*:*:compile</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
