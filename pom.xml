<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.stintflow</groupId>
    <artifactId>stint-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Stint :: Parent</name>
    <description>Cloud-agnostic, distributed, serverless execution engine for CNCF Serverless Workflows.</description>

    <!-- Project: Stint. GitHub org: stintflow (github.com/stintflow). Not git-initialised yet. -->

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <!-- 3.33.x is the first line that supports JDK 25 (matches the sibling quarkus-flow project). -->
        <quarkus.platform.version>3.33.2</quarkus.platform.version>

        <cloudevents.version>4.0.1</cloudevents.version>
        <jackson-jq.version>1.6.0</jackson-jq.version>

        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <surefire-plugin.version>3.2.5</surefire-plugin.version>
        <archunit.version>1.5.1</archunit.version>
        <assertj.version>3.26.3</assertj.version>
        <exec-plugin.version>3.2.0</exec-plugin.version>
        <enforcer-plugin.version>3.5.0</enforcer-plugin.version>
    </properties>

    <modules>
        <module>stint-spi</module>
        <module>stint-wire</module>
        <module>stint-core</module>
        <module>stint-dsl</module>
        <module>stint-worker-sdk</module>
        <module>stint-worker-decision</module>
        <module>stint-worker-langchain4j</module>
        <module>stint-worker-decision-jev</module>
        <module>stint-worker-redaction</module>
        <module>stint-worker-transcription</module>
        <module>stint-worker-publishing</module>
        <module>stint-otel</module>
        <module>connectors/stint-inmemory</module>
        <module>connectors/stint-aws</module>
        <module>connectors/stint-aws-conversations</module>
        <module>connectors/stint-aws-worker</module>
        <module>bundles/stint-bundle-local</module>
        <module>bundles/stint-bundle-aws</module>
        <module>examples/stint-example-build-report</module>
        <module>examples/stint-example-send-report</module>
        <module>examples/stint-example-archive-report</module>
        <module>examples/stint-example-aws-smoke</module>
        <module>examples/stint-example-ai-worker</module>
        <module>examples/stint-example-product-meeting</module>
        <module>stint-it</module>
        <module>stint-architecture-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus core platform BOM -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Platform-aligned member BOM: manages quarkus-amazon-* extensions AND the underlying
                 AWS SDK v2 versions (so raw clients like eventbridge / url-connection-client align too). -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SDD 3a.3, ADR 3a.3-A: plain LangChain4j (dev.langchain4j:*), with the versions the Quarkus platform
                 aligns (langchain4j 1.11.7 on 3.33.2), so a worker may also use a quarkus-langchain4j model provider
                 without a version clash. Only stint-worker-langchain4j and the workers that use it depend on it. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- CloudEvents: the agnostic wire contract. CNCF lib, NOT a cloud SDK. -->
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-bom</artifactId>
                <version>${cloudevents.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-wire</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-dsl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-decision</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-langchain4j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-decision-jev</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-otel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-inmemory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-aws-conversations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-aws-worker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-redaction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-transcription</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-worker-publishing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-aws-worker</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-bundle-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.stintflow</groupId>
                <artifactId>stint-bundle-aws</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- SDD 1.1: default ExpressionEvaluator implementation (RF5). Pure Java, JsonNode-native,
                 no reflection-heavy magic beyond ServiceLoader for built-ins (see SDD 1.1 sec. 8a).
                 Jackson transitives are excluded so the Quarkus BOM's Jackson versions win. -->
            <dependency>
                <groupId>net.thisptr</groupId>
                <artifactId>jackson-jq</artifactId>
                <version>${jackson-jq.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                </plugin>
                <!-- SDD 3a.2, CA4: a test JVM resolves only the names in build/test-hosts (localhost), so no test can
                     reach a real model provider (api.openai.com, api.typesafe.ai, ...) even by mistake. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-Djdk.net.hosts.file=${maven.multiModuleProjectDirectory}/build/test-hosts</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-Djdk.net.hosts.file=${maven.multiModuleProjectDirectory}/build/test-hosts</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
