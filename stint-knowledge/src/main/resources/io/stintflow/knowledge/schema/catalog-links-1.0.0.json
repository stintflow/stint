{
  "schema": "catalog-links",
  "version": "1.0.0",
  "language": "en",
  "nodes": {
    "DomainReference": {
      "key": "pointer",
      "defaultSensitivity": "internal",
      "properties": {
        "pointer": {"type": "string", "required": true, "pattern": "stint-kg://[a-z0-9][a-z0-9._-]{0,62}/[a-z0-9][a-z0-9._-]{0,62}/[a-z0-9][a-z0-9._-]{0,127}[?]v=[1-9][0-9]{0,18}"},
        "remoteType": {"type": "string", "required": true},
        "domain": {"type": "string", "required": true},
        "observedVersion": {"type": "string", "required": true, "pattern": "[1-9][0-9]{0,18}"}
      }
    },
    "System": {"key": "name", "defaultSensitivity": "internal", "properties": {"name": {"type": "string", "required": true}}},
    "Product": {"key": "name", "defaultSensitivity": "internal", "properties": {"name": {"type": "string", "required": true}}},
    "Team": {"key": "name", "defaultSensitivity": "internal", "properties": {"name": {"type": "string", "required": true}}}
  },
  "relations": {
    "denotes": {"from": ["System", "Product", "Team"], "to": ["DomainReference"]}
  }
}
